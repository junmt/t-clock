<Window x:Class="TClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="t-clock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="240"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Yu Gothic UI"
        TextOptions.TextFormattingMode="Display"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_DragMove">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 色 -->
        <SolidColorBrush x:Key="Fg" Color="#F2F4F8" />
        <SolidColorBrush x:Key="Muted" Color="#9AA3B2" />
        <SolidColorBrush x:Key="Accent" Color="#4DA3FF" />
        <SolidColorBrush x:Key="Danger" Color="#FF5D5D" />
        <SolidColorBrush x:Key="Chip" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="Border" Color="#1FFFFFFF" />

        <!-- ツールバー/汎用ボタン -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="{DynamicResource Chip}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#04121F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="#4D000000" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 本体カード -->
        <Border x:Name="CardBorder" MinWidth="220" CornerRadius="12" Padding="10,8"
                Background="#D914161C" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <StackPanel>
                <!-- 時計 -->
                <StackPanel x:Name="ClockArea" HorizontalAlignment="Center">
                    <TextBlock x:Name="TimeText" Text="--:--:--" Foreground="{DynamicResource Fg}"
                               FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DateText" Text="" Foreground="{DynamicResource Muted}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 実行中タイマー一覧 -->
                <ItemsControl x:Name="TimersControl" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Background="{DynamicResource Chip}" CornerRadius="8"
                                    Padding="8,4" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding RemainingText}"
                                               Foreground="{DynamicResource Fg}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="6,0" />
                                    <Button Grid.Column="2" Style="{StaticResource ToolBtn}"
                                            Content="{Binding PrimaryGlyph}" ToolTip="{Binding PrimaryTip}"
                                            Click="Primary_Click" />
                                    <Button Grid.Column="3" Style="{StaticResource ToolBtn}" Content="↺"
                                            ToolTip="リセット" Click="Reset_Click"
                                            Visibility="{Binding CanReset, Converter={StaticResource BoolToVis}}" />
                                    <Button Grid.Column="4" Style="{StaticResource ToolBtn}" Content="✕"
                                            ToolTip="削除" Foreground="{StaticResource Danger}"
                                            Click="Remove_Click" />
                                </Grid>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Background" Value="#40FF5D5D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 操作パネル(ホバー時に表示) -->
                <StackPanel x:Name="PanelRoot" Visibility="Collapsed" Margin="0,6,0,0">
                    <Separator Background="{DynamicResource Border}" Margin="0,0,0,4" />

                    <!-- クイックタイマー -->
                    <UniformGrid Rows="1" Margin="0,0,0,4">
                        <Button Style="{StaticResource ToolBtn}" Content="+1分" Tag="1" Click="Quick_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="+3分" Tag="3" Click="Quick_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="+5分" Tag="5" Click="Quick_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="+10分" Tag="10" Click="Quick_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="+15分" Tag="15" Click="Quick_Click" />
                    </UniformGrid>

                    <TextBox x:Name="LabelInput" Style="{StaticResource Input}" MaxLength="20"
                             Tag="ラベル(任意)" />

                    <!-- カウントダウン -->
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="MinInput" Style="{StaticResource Input}" Width="46" Text="5"
                                 TextAlignment="Center" ToolTip="分" />
                        <TextBlock Text="分" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="1,0" />
                        <TextBox x:Name="SecInput" Style="{StaticResource Input}" Width="46" Text="0"
                                 TextAlignment="Center" ToolTip="秒" />
                        <TextBlock Text="秒" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="1,0" />
                        <Button Style="{StaticResource PrimaryBtn}" Content="開始" Click="StartCountdown_Click" />
                    </StackPanel>

                    <!-- アラーム(指定時刻) -->
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="AlarmInput" Style="{StaticResource Input}" Width="70" Text="07:00"
                                 TextAlignment="Center" ToolTip="アラーム時刻 HH:MM" />
                        <Button Style="{StaticResource ToolBtn}" Content="時刻設定" Click="StartAlarm_Click" />
                    </StackPanel>

                    <!-- ツールバー -->
                    <WrapPanel Margin="0,4,0,0">
                        <Button x:Name="TopBtn" Style="{StaticResource ToolBtn}" Content="📌" ToolTip="最前面表示" Click="ToggleTop_Click" />
                        <Button x:Name="ThroughBtn" Style="{StaticResource ToolBtn}" Content="🖱" ToolTip="クリックスルー" Click="ToggleThrough_Click" />
                        <Button x:Name="SecondsBtn" Style="{StaticResource ToolBtn}" Content="秒" ToolTip="秒表示" Click="ToggleSeconds_Click" />
                        <Button x:Name="CompactBtn" Style="{StaticResource ToolBtn}" Content="▭" ToolTip="コンパクト表示" Click="ToggleCompact_Click" />
                        <Button x:Name="AutostartBtn" Style="{StaticResource ToolBtn}" Content="⚡" ToolTip="Windows起動時に自動起動" Click="ToggleAutostart_Click" />
                        <Button x:Name="ThemeBtn" Style="{StaticResource ToolBtn}" Content="🎨" ToolTip="配色を切替" Click="CycleTheme_Click" />
                        <Slider x:Name="OpacitySlider" Width="80" Minimum="20" Maximum="100" Value="90"
                                VerticalAlignment="Center" Margin="4,0" ToolTip="不透明度"
                                ValueChanged="Opacity_Changed" />
                        <Button x:Name="QuitBtn" Style="{StaticResource ToolBtn}" Content="✕終了"
                                Foreground="{StaticResource Danger}" ToolTip="終了" Click="Quit_Click" />
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 通知フラッシュ用オーバーレイ -->
        <Border x:Name="FlashOverlay" Background="{StaticResource Danger}" Opacity="0"
                IsHitTestVisible="False" CornerRadius="12" />
    </Grid>
</Window>
